    // True to display in-app guides.
    "showInAppGuides": true,

    // see `languageOverrides.json` in languages/en
    "languageConfiguration": {
      "enabled": true,
      "debug": true,
      "languages": {
        "en": "English",
        "it": "Italiano"
      },
      "fallbackLanguage": "en"
    },
    "searchBarConfig": {},
    "searchProviders": [
      // Nominatim search restricted to Italy — carries over the legacy fork's
